# --- Doppler (optional) ---
# If DOPPLER_TOKEN is set, the backup runs under `doppler run` and S3_*
# credentials are fetched from the token's project/config (the scoped service
# token determines them itself, no project/config needed here).
# If a secret does not exist in Doppler, the value from this file is used as a fallback.
# POSTGRES_* credentials are always taken from this file, never from Doppler.
DOPPLER_TOKEN=

# --- S3 ---
# Required (or set in Doppler). Overridden by Doppler values when DOPPLER_TOKEN is set.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_REGION=
S3_ENDPOINT=

# --- PostgreSQL ---
# Always read from this file (host:port format is supported, or set POSTGRES_PORT).
POSTGRES_HOST=localhost:5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Schedule ---
# Cron expression for regular backups, e.g. "0 2 * * *" = every day at 02:00.
# Leave empty to run a single backup and exit.
BACKUP_SCHEDULE=
